#!/bin/bash
# Fuzzy find directories and open one in a tmux session

for cmd in fzf tmux; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "fuzzymux: '$cmd' is required but not installed" >&2; exit 1; }
done

topDirs=$(find ~ -mindepth 1 -maxdepth 1 -type d -not -name '.*')

dir=$(find $topDirs -maxdepth 5 -type d \
    -not -path '*/.git*' \
    -not -path '*/node_modules*' \
    -not -path '*/.venv*' \
    -not -path '*/__pycache__*' \
    | fzf)

if [[ $dir ]]; then
    cd $dir
    baseName=$(basename $dir)
    if [[ -z "${TMUX}" ]]; then
        tmux new -A -s $baseName
    else
        tmux new -A -s $baseName -d
    fi
        tmux switch-client -t $baseName
fi
